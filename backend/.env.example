# Copy to .env and uncomment what you want to change.
# Every setting in app/core/config.py can be set here with the LOGSIGHT_ prefix.

# Database. Defaults to a SQLite file at <storage_dir>/logsight.db.
# LOGSIGHT_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/logsight

# Where uploads and the SQLite file are kept. Defaults to backend/storage.
# LOGSIGHT_STORAGE_DIR=

# Project root containing the pipeline code (engine/). Defaults to the parent of backend/.
# LOGSIGHT_EXPERIMENT_ROOT=

# Precomputed experiment outputs for `import-artifacts`. Defaults to <experiment_root>/data/processed.
# LOGSIGHT_ARTIFACTS_DIR=

# Pipeline parameter file. Defaults to backend/config/pipeline.yaml.
# LOGSIGHT_PIPELINE_CONFIG_PATH=

# Frontend origins allowed to call the API (JSON list). Empty = CORS disabled.
# LOGSIGHT_CORS_ORIGINS=["http://localhost:5173"]

# LOGSIGHT_API_PREFIX=/api/v1
# LOGSIGHT_MAX_UPLOAD_MB=1024
# LOGSIGHT_PIPELINE_WORKERS=1
# LOGSIGHT_PAGE_SIZE_DEFAULT=50
# LOGSIGHT_PAGE_SIZE_MAX=500
